# ふたまるのファームウェアの既定の設定（秘密情報は sdkconfig.secrets に書く）
CONFIG_IDF_TARGET="esp32s3"

#
# ふたまる（main/Kconfig.projbuild）
#
CONFIG_FUTAMARU_USE_AEC=y
CONFIG_FUTAMARU_SPEAKER_VOLUME=85
CONFIG_FUTAMARU_MIC_GAIN_DB=30
CONFIG_FUTAMARU_STATUS_LED=y

#
# Wi-Fi（livekit/example_utils）。切れても何度でもつなぎ直す
#
CONFIG_LK_EXAMPLE_USE_WIFI=y
CONFIG_LK_EXAMPLE_NETWORK_MAX_RETRIES=-1

#
# 中継（relay）との WebSocket（main/relay.c）
#
# wss:// のサーバーの証明書を、ESP-IDF 同梱の証明書の束で確かめる
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
# TLS の作業場所を PSRAM に置き、内部 RAM を空けておく
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
# 送信（マイクの音）と受信（植物の声）が待ち合わないよう、送信用の鍵を分ける
CONFIG_ESP_WS_CLIENT_SEPARATE_TX_LOCK=y

#
# 録音・エコーキャンセル（esp_capture・esp-sr）と全体（esp_capture のサンプルと同じ）
#
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
# 動画は使わない（ビルドを軽くする）
CONFIG_ESP_CAPTURE_ENABLE_VIDEO=n
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

#
# Seeed XIAO ESP32S3（Flash 8MB・Octal PSRAM 8MB）
#
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=256
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=8192
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# XIAO の USB-C は ESP32-S3 の USB（USB Serial/JTAG）に直結。ログはここに出す
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# esp_codec_dev は新しい I2C ドライバ（i2c_master）で使う。古いドライバと混ぜると起動時に止まる
CONFIG_CODEC_I2C_BACKWARD_COMPATIBLE=n
