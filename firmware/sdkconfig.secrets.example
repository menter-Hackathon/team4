# sdkconfig.secrets.example — これをコピーして sdkconfig.secrets を作り、値を埋める
#   cp sdkconfig.secrets.example sdkconfig.secrets
# sdkconfig.secrets は .gitignore 済み。コミット・Issue・PR・チャンネルに貼らない
#
# 値を変えたら、古い設定が残らないように sdkconfig を消してからビルドする
#   rm -f sdkconfig && idf.py build

# Wi-Fi（ESP32-S3 は 2.4GHz だけ。5GHz だけの Wi-Fi にはつながらない）
CONFIG_LK_EXAMPLE_WIFI_SSID=""
CONFIG_LK_EXAMPLE_WIFI_PASSWORD=""

# サーバーの中継（relay）の URL（仕様 §3.2.1）。例: wss://<ホスト>/relay
# 手元の PC で試すときは ws://<PC の IP>:<ポート>/relay
CONFIG_FUTAMARU_RELAY_URL=""
# 中継につなぐときの合言葉（サーバー側と同じ値。サーバー担当に聞く）
CONFIG_FUTAMARU_DEVICE_KEY=""
# どの株として話すか（英小文字・数字・_・- で 1〜32 文字）。2 台目は b1 など
CONFIG_FUTAMARU_PLANT_ID="a1"
