# LiveKit Cloud
LIVEKIT_URL=wss://<project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# LLM: Gemma 4 E4B on vLLM など (OpenAI 互換、仕様 §8.1)。<pc> はモデルを動かす PC（自分なら localhost）
# 準備ができるまでは OpenAI で代用できる: LLM_BASE_URL=https://api.openai.com/v1、LLM_MODEL=gpt-4o-mini、LLM_API_KEY=OpenAI のキー
LLM_BASE_URL=http://<pc>:8000/v1
# google/gemma-4-E4B-it（Ollama などで動かした場合はその名前）
LLM_MODEL=
LLM_API_KEY=EMPTY
# 思考モードを切る指定。Ollama で Gemma 4 を動かすときだけ none にする（Ollama の Gemma 4 は既定で思考し、遅くなる）。
# vLLM（Docker）と OpenAI では空のままにする（OpenAI の gpt-4o-mini は none を受け付けない）
LLM_REASONING_EFFORT=

# STT: kotoba-whisper on Speaches (OpenAI 互換)
# 準備ができるまでは OpenAI で代用できる: STT_BASE_URL=https://api.openai.com/v1、STT_MODEL=gpt-4o-mini-transcribe、STT_API_KEY=OpenAI のキー
STT_BASE_URL=http://<pc>:8001/v1
STT_MODEL=kotoba-tech/kotoba-whisper-v2.0-faster
STT_API_KEY=EMPTY

# TTS の種類: openai（空なら openai）か aivis（ローカルの AivisSpeech Engine、仕様 §8.3）
TTS_PROVIDER=
# AivisSpeech（TTS_PROVIDER=aivis のときだけ使う）。URL は空なら http://127.0.0.1:10101
# AIVIS_SPEAKER は声のスタイル ID（空なら 888753762 =「まお」の「あまあま」）。uv run python -m scripts.aivis_voices --list で調べる
# AIVIS_SPEED は話す速さ（空なら 1.0）、AIVIS_PITCH は声の高さ（空なら 0.0。少し上げると幼く聞こえる）
AIVIS_BASE_URL=
AIVIS_SPEAKER=
AIVIS_SPEED=
AIVIS_PITCH=
# TTS: OpenAI gpt-4o-mini-tts（TTS_PROVIDER=openai のとき）。TTS_BASE_URL を設定すると OpenAI 互換の自前 TTS に向く
OPENAI_API_KEY=
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=coral
TTS_BASE_URL=

# エージェント
FUTAMARU_DB_PATH=./data/futamaru.db
WAKE_WORDS=ふたまる,二丸,ふた丸,2丸,下丸
SLEEP_AFTER_SECONDS=60
LLM_TIMEOUT=15
STT_TIMEOUT=10
TTS_TIMEOUT=10
# 話し終わりの判定（秒、#39）。合計が「話し終えてから返事を作り始めるまで」の待ちになる。
# 短くするほど返事が早くなるが、短すぎると「えーと…」の間で話を切られる。まず 0.35 / 0.2 くらいで試す
VAD_MIN_SILENCE_SECONDS=0.55
ENDPOINTING_DELAY_SECONDS=0.5

# 天気を取る場所（気象庁のデータ、仕様 §6.7、#80）。書くと植物が天気・気温・湿度を話す。両方空なら天気を使わない
# アメダスの観測所のコード（気温・湿度）。一覧: https://www.jma.go.jp/bosai/amedas/const/amedastable.json
#   例: 東京 44132。湿度を測っていない観測所もあるので、一覧で "hum" があるか確かめる
JMA_AMEDAS_STATION=
# 予報の地域コード（晴れ・くもり・雨・雪）。一覧: https://www.jma.go.jp/bosai/common/const/area.json の offices
#   例: 東京都 130000
JMA_FORECAST_AREA=
# 湿度がこの値（%）未満なら「乾燥している」と言う（空なら 40）
WEATHER_DRY_HUMIDITY=
# 水をもらってからこの日数たつと「のどが渇いた」と言う（空なら 3、#81）
WATER_REMIND_DAYS=
# 植物の種類（空ならポトス、#83）。ポトス・モンステラ・パキラ・サンスベリア・ガジュマルは育て方のメモつき。
# ほかの種類も書けるが、そのときは種類の名前だけを植物に伝える
PLANT_SPECIES=

# console モード専用の plant_id（開発用）。dev / start モードでは使われない
DEV_PLANT_ID=

# --- Docker で脳を動かすときだけ使う（compose.yaml、手順は docs/deploy.md） ---
# Hugging Face のトークン（任意）。Gemma 4 E4B は同意不要の公開モデルなので空でもよい。書くと回数制限に当たりにくい
HF_TOKEN=
# Docker の STT で使うモデル（空なら kotoba-tech/kotoba-whisper-v2.0-faster）。読み込めないときの切り替え用
DOCKER_STT_MODEL=
